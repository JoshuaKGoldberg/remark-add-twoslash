{
	"name": "remark-add-twoslash",
	"version": "0.0.1",
	"description": "Automatically adds twoslash meta to code blocks in Markdown. 🎸",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/remark-add-twoslash.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "git@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./lib/index.js"
	},
	"main": "lib/index.js",
	"files": [
		"lib/"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"tsc": "tsc"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"@types/mdast": "^4.0.4",
		"unist-util-visit": "^5.1.0",
		"vfile": "^6.0.3"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "7.5.1",
		"@release-it/conventional-changelog": "10.0.5",
		"@types/node": "25.9.5",
		"cspell": "9.7.0",
		"eslint": "10.0.3",
		"eslint-plugin-jsdoc": "62.7.1",
		"eslint-plugin-jsonc": "3.1.1",
		"eslint-plugin-n": "17.24.0",
		"eslint-plugin-package-json": "0.89.4",
		"eslint-plugin-perfectionist": "5.6.0",
		"eslint-plugin-regexp": "3.0.0",
		"eslint-plugin-yml": "3.3.1",
		"husky": "9.1.7",
		"knip": "5.86.0",
		"lint-staged": "16.3.2",
		"prettier": "3.8.1",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-sentences-per-line": "0.2.3",
		"prettier-plugin-sh": "0.18.0",
		"release-it": "19.2.4",
		"tsdown": "0.21.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.56.1"
	},
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=20.19.0"
	}
}
